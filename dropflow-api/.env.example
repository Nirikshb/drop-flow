NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/database_name
FRONTEND_URL=http://127.0.0.1:3000

# Min 32 chars. Required in production.
SESSION_SECRET=

# Cloudflare R2 (S3-compatible). Filled in during Phase 3.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

LOG_LEVEL=log
